  "guided_practice_overrides": {
    "n5-module-b-u01-guided-grammar-01-v1": {
      "prompt_ja": "あの人___大人です。",
      "options": [
        {
          "option_id": "A",
          "text": "は"
        },
        {
          "option_id": "B",
          "text": "を"
        },
        {
          "option_id": "C",
          "text": "か"
        },
        {
          "option_id": "D",
          "text": "と"
        }
      ],
      "feedback_zh": "这里要先提出「あの人」作为话题，所以用「は」。完整句子是「あの人は大人です」。"
    },
    "n5-module-b-u01-guided-grammar-02-v1": {
      "prompt_ja": "女の人___。",
      "options": [
        {
          "option_id": "A",
          "text": "ます"
        },
        {
          "option_id": "B",
          "text": "でしたか"
        },
        {
          "option_id": "C",
          "text": "を"
        },
        {
          "option_id": "D",
          "text": "です"
        }
      ],
      "feedback_zh": "「女の人」是名词短语，后面直接接礼貌表达「です」。"
    }
  },
