      "audio_segments": [
        {
          "voice_role": "female",
          "text_ja": "バスで行きましょう。"
        },
        {
          "voice_role": "male",
          "text_ja": "今日はバスがありません。電車で行きましょう。"
        },
        {
          "voice_role": "female",
          "text_ja": "そうしましょう。"
        }
      ]
    },
    {
      "item_id": "n5-g3-listening-l02-teaching-meeting-change-v1",
      "correct_option_id": "C",
      "explanation_zh": "七点因工作被否定，最后确认八点。",
      "audio_segments": [
        {
          "voice_role": "male",
          "text_ja": "七時に会いましょう。"
