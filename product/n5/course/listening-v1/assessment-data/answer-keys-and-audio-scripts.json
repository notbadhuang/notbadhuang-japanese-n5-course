        {
          "voice_role": "male",
          "text_ja": "じゃ、飲み物を買います。"
        }
      ]
    },
    {
      "item_id": "n5-g3-listening-l01-practice-departure-v1",
      "correct_option_id": "B",
      "explanation_zh": "八点十分是出发，九点是到达。",
      "audio_segments": [
        {
          "voice_role": "male",
          "text_ja": "電車は八時十分に出て、九時に着きます。"
        }
      ]
