  "items": [
    {
      "item_id": "n5-g3-listening-l01-teaching-arrival-v1",
      "correct_option_id": "D",
      "explanation_zh": "题目只问到达时间，九点是出发时间。",
      "audio_segments": [
        {
          "voice_role": "male",
          "text_ja": "九時に出ます。十時半に着きます。"
        }
      ]
    },
    {
      "item_id": "n5-g3-listening-l01-teaching-fruit-count-v1",
