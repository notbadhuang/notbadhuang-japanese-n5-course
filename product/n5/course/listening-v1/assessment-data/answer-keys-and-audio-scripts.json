        }
      ]
    },
    {
      "item_id": "n5-g3-listening-l01-stage_check-teacher-time-v1",
      "correct_option_id": "C",
      "explanation_zh": "人物必须和时间绑定，老师是九点半。",
      "audio_segments": [
        {
          "voice_role": "female",
          "text_ja": "先生は九時半に来ます。学生は九時に来ます。"
        }
      ]
    },
    {
      "item_id": "n5-g3-listening-l01-hidden_validation-train-time-v1",
      "correct_option_id": "C",
      "explanation_zh": "七点那班已经离开，下一班是七点二十分。",
      "audio_segments": [
        {
          "voice_role": "male",
          "text_ja": "七時の電車はもう出ました。次は七時二十分です。"
        }
      ]
    },
    {
