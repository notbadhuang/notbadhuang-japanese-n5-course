{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "n5-calendar-constraints-v1.schema.json",
  "title": "N5 calendar scheduling constraints",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "planning_start_date",
    "planning_end_date",
    "daily_start_time_by_weekday",
    "unavailable_periods"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "planning_start_date": {
      "type": "string",
      "format": "date"
    },
    "planning_end_date": {
      "type": "string",
      "format": "date"
    },
    "daily_start_time_by_weekday": {
      "type": "object",
      "propertyNames": {
        "enum": [
          "monday",
          "tuesday",
          "wednesday",
          "thursday",
          "friday",
          "saturday",
          "sunday"
        ]
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
      }
    },
    "unavailable_periods": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "period_id",
          "starts_at",
          "ends_at"
        ],
        "properties": {
          "period_id": {
            "type": "string",
            "pattern": "^unavailable-[a-z0-9-]+$"
          },
          "starts_at": {
            "type": "string",
            "format": "date-time"
          },
          "ends_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  }
}
